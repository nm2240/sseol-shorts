{
 "lines": [
  {
   "spk": "나레이터",
   "text": "제 집을 줄자로 재고 다니던 사위, 한 달 뒤 식탁 위 공책을 보고 결국 울었습니다."
  },
  {
   "spk": "사위",
   "text": "\"어머님, 이 집에서 언제까지 혼자 사실 거예요?\""
  },
  {
   "spk": "나레이터",
   "text": "사위가 그렇게 물은 게 이 년 전이었어요."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 일흔하나입니다."
  },
  {
   "spk": "나레이터",
   "text": "남편을 먼저 보내고 마당 있는 옛날 집에서 혼자 삽니다."
  },
  {
   "spk": "나레이터",
   "text": "딸네는 차로 한 시간 거리 시내에 사는데, 맞벌이라 명절에나 얼굴을 보죠."
  },
  {
   "spk": "나레이터",
   "text": "그런데 사위는 한 달에 두 번, 일요일마다 혼자 내려왔습니다."
  },
  {
   "spk": "나레이터",
   "text": "와서는 밥도 안 먹고 보일러실이랑 화장실만 들여다보다 삼십 분 만에 돌아갔습니다."
  },
  {
   "spk": "나레이터",
   "text": "어느 날은 줄자를 꺼내 방 크기를 재고, 문턱에도 줄자를 대 봤습니다."
  },
  {
   "spk": "나레이터",
   "text": "현관이며 계단이며 사진도 찍어 갔고요."
  },
  {
   "spk": "장모",
   "text": "\"자네, 뭘 그렇게 재는가?\""
  },
  {
   "spk": "사위",
   "text": "\"그냥요, 어머님. 신경 쓰지 마세요.\""
  },
  {
   "spk": "나레이터",
   "text": "그 대답이 더 마음에 걸렸습니다."
  },
  {
   "spk": "나레이터",
   "text": "동네 언니한테 얘기했더니 혀를 차더라고요."
  },
  {
   "spk": "동네 언니",
   "text": "\"사위가 집을 재고 다니면 그거 팔 궁리여. 요양원 알아보는 거라고.\""
  },
  {
   "spk": "나레이터",
   "text": "설마 싶었지만, 사람 속은 모르는 거죠."
  },
  {
   "spk": "나레이터",
   "text": "그 뒤로는 사위가 와도 커피 한 잔 안 내주고 대문 앞에서 돌려보냈습니다."
  },
  {
   "spk": "나레이터",
   "text": "그렇게 이 년이 흘렀습니다."
  },
  {
   "spk": "나레이터",
   "text": "지난겨울 새벽, 화장실에 가다 문턱에 걸려 넘어졌습니다."
  },
  {
   "spk": "나레이터",
   "text": "손목이 부러져서 딸네 집에서 한 달을 지내게 됐죠."
  },
  {
   "spk": "나레이터",
   "text": "그동안 사위는 회사 일이 바쁘다며 저녁마다 늦게 들어왔어요."
  },
  {
   "spk": "나레이터",
   "text": "집을 팔자는 말이 언제 나올까, 저는 그것만 기다렸어요."
  },
  {
   "spk": "나레이터",
   "text": "한 달째 되던 날, 참다못해 제가 먼저 물었습니다."
  },
  {
   "spk": "장모",
   "text": "\"자네, 내 집 팔려고 그러는 거지?\""
  },
  {
   "spk": "나레이터",
   "text": "사위는 대답 대신 차 열쇠를 집어 들었습니다."
  },
  {
   "spk": "사위",
   "text": "\"어머님, 집에 한번 같이 가 보세요.\""
  },
  {
   "spk": "나레이터",
   "text": "대문을 열자마자 저는 걸음을 멈췄어요."
  },
  {
   "spk": "나레이터",
   "text": "마당 계단 옆에 손잡이가 달려 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "넘어졌던 문턱은 다 없어지고, 화장실엔 미끄럼 방지 타일이 깔려 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "복도에는 밤에 저절로 켜지는 불이 달려 있었고요."
  },
  {
   "spk": "나레이터",
   "text": "식탁 위에는 낡은 공책 한 권이 놓여 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "첫 장부터 사위 글씨가 빼곡했습니다."
  },
  {
   "spk": "나레이터",
   "text": "'현관 문턱 칠 센티. 어머님, 밤에 화장실 세 번.'"
  },
  {
   "spk": "나레이터",
   "text": "이 년 동안 재고 찍어 간 게 전부 그 공책에 있었던 거죠."
  },
  {
   "spk": "딸",
   "text": "\"엄마, 이 사람 어머님 돌아가실 때 기억나지? 혼자 계시다 화장실에서 넘어지셨잖아.\""
  },
  {
   "spk": "딸",
   "text": "\"반나절 만에 발견되셨대. 그래서 엄마 집은 꼭 고쳐 드린다고 했어.\""
  },
  {
   "spk": "나레이터",
   "text": "사위는 연차를 몰아 쓰고, 퇴근한 뒤에도 내려가서 혼자 공사를 했답니다."
  },
  {
   "spk": "나레이터",
   "text": "저녁마다 늦게 들어온 이유가 그거였어요."
  },
  {
   "spk": "장모",
   "text": "\"이 사람아, 그럼 말을 하지. 왜 말을 안 했어.\""
  },
  {
   "spk": "사위",
   "text": "\"말씀드리면 돈 쓰지 말라고 하실 거잖아요.\""
  },
  {
   "spk": "사위",
   "text": "\"이번에는 어머님 혼자 넘어지시게 두고 싶지 않았어요.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 사위 손을 잡고 한참을 울었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그제야 깨달았습니다."
  },
  {
   "spk": "나레이터",
   "text": "사위는 제 집을 팔 궁리를 한 게 아니라, 제가 이 집에서 오래 살 수 있게 재고 있었던 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "그날 처음으로 사위를 붙잡아 밥을 차려 줬어요."
  },
  {
   "spk": "나레이터",
   "text": "사위가 김치찌개를 좋아한다는 것도 그날 처음 알았죠."
  },
  {
   "spk": "나레이터",
   "text": "말없이 하는 효도도 있더라고요."
  },
  {
   "spk": "나레이터",
   "text": "여러분이라면 사위에게 무슨 말을 해 주시겠어요?"
  },
  {
   "spk": "나레이터",
   "text": "공감하셨다면 구독과 좋아요 부탁드립니다."
  }
 ],
