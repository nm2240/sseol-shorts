{
 "lines": [
  {
   "spk": "나레이터",
   "text": "축의금 가방 들고 사라진 큰아들, 열흘 뒤 가방 속 전표 다섯 장에 울었습니다."
  },
  {
   "spk": "막내",
   "text": "\"아버지, 형이 축의금 가방을 들고 없어졌어요!\""
  },
  {
   "spk": "나레이터",
   "text": "저는 그날, 큰아들을 키운 게 처음으로 부끄러웠어요."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 일흔이고, 오 년 전 아내를 떠나보내고 혼자 삽니다."
  },
  {
   "spk": "나레이터",
   "text": "삼 년 전 큰아들 이삿짐 회사가 망해, 제 퇴직금 삼천을 빚 갚는 데 내줬어요."
  },
  {
   "spk": "나레이터",
   "text": "그 뒤론 남의 이삿짐 센터에서 짐을 나르죠."
  },
  {
   "spk": "나레이터",
   "text": "돈을 갚겠다는 말은, 삼 년 동안 한 번도 없었습니다."
  },
  {
   "spk": "나레이터",
   "text": "축의금은, 막내 전세 잔금에 모자란 천팔백만 원을 채우기로 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "결혼식 전날 밤엔, 형제가 방에서 언성을 높이더라고요."
  },
  {
   "spk": "나레이터",
   "text": "저는 또 돈 얘기려니 하고, 모른 척했습니다."
  },
  {
   "spk": "큰아들",
   "text": "\"아버지, 내일 축의금 받는 자리는 제가 맡을게요.\""
  },
  {
   "spk": "나레이터",
   "text": "빚진 아들이 돈 자리에 앉겠다니, 그게 영 마음에 걸렸죠."
  },
  {
   "spk": "나레이터",
   "text": "식이 끝나자 큰아들은 축의금 가방을 들고, 그대로 사라졌습니다."
  },
  {
   "spk": "나레이터",
   "text": "전화는 며칠 내내 꺼져 있었어요."
  },
  {
   "spk": "나레이터",
   "text": "막내는 잔금 날을, 집주인에게 사정해 두 주 미뤘습니다."
  },
  {
   "spk": "나레이터",
   "text": "신혼부부는 처가 작은방에 짐을 풀었죠."
  },
  {
   "spk": "막내",
   "text": "\"형이랑은 이제 끝이에요! 아버지도 형 편 들지 마세요.\""
  },
  {
   "spk": "나레이터",
   "text": "열흘째 되던 날, 막내는 대출로 잔금을 치르겠다고 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그날 밤, 큰아들이 가방을 들고 돌아왔어요."
  },
  {
   "spk": "나레이터",
   "text": "가방 속 축의금 봉투는, 한 장도 뜯기지 않았습니다."
  },
  {
   "spk": "나레이터",
   "text": "그 위에, 고무줄로 묶은 이삿짐 전표 다섯 장이 있었죠."
  },
  {
   "spk": "나레이터",
   "text": "다섯 장 모두, 막내 신혼집 건물 주소였습니다."
  },
  {
   "spk": "큰아들",
   "text": "\"그 건물에서 석 달 동안, 다섯 집 짐을 날랐어요.\""
  },
  {
   "spk": "큰아들",
   "text": "\"다 보증금을 못 받고, 쫓기듯 나가는 집이었어요.\""
  },
  {
   "spk": "나레이터",
   "text": "결혼식 전날, 계약서 주소를 보고 손이 떨렸답니다."
  },
  {
   "spk": "큰아들",
   "text": "\"말려도 안 믿더라고요. 잔금만 못 치르게 하면 된다 싶었어요.\""
  },
  {
   "spk": "큰아들",
   "text": "\"전화 받으면, 울며 달라는 막내한테 줄 것 같았어요.\""
  },
  {
   "spk": "아버지",
   "text": "\"그 얘기를, 왜 나한테는 안 했냐.\""
  },
  {
   "spk": "큰아들",
   "text": "\"빚진 형 말을, 아버지가 믿어 주셨겠어요?\""
  },
  {
   "spk": "나레이터",
   "text": "열흘 동안 회사 창고를 뒤져, 그 주소 전표만 찾아 왔다더라고요."
  },
  {
   "spk": "큰아들",
   "text": "\"계약금 이천은 못 돌려받을 거예요. 그건 제 적금으로 채울게요.\""
  },
  {
   "spk": "나레이터",
   "text": "제 퇴직금을 갚으려고, 삼 년 동안 부어 온 적금이었습니다."
  },
  {
   "spk": "나레이터",
   "text": "막내는 그 자리에서, 대출 신청을 취소했죠."
  },
  {
   "spk": "나레이터",
   "text": "이틀 뒤, 그 집주인이 연락을 끊고 사라졌어요."
  },
  {
   "spk": "나레이터",
   "text": "같은 건물 열한 집이, 보증금을 떼였다고 하더군요."
  },
  {
   "spk": "큰아들",
   "text": "\"아버지, 이번에는 제가 망친 거 말고, 지킨 걸로 봐 주세요.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 목이 메어, 아무 말도 하지 못했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그제야 알았습니다. 큰아들은 축의금을 들고 도망친 게 아니었어요."
  },
  {
   "spk": "나레이터",
   "text": "막내 보증금을, 혼자 지키고 있었던 겁니다."
  },
  {
   "spk": "아버지",
   "text": "\"아버지 돈은 안 갚아도 된다. 너는 오늘 다 갚았다.\""
  },
  {
   "spk": "나레이터",
   "text": "그날 밤 저는 삼 년 만에, 큰아들과 소주잔을 부딪쳤어요."
  },
  {
   "spk": "나레이터",
   "text": "막내는 지금, 형이 짐을 날라 준 작은 전셋집에서 삽니다."
  },
  {
   "spk": "나레이터",
   "text": "미운 짓 뒤에, 가장 깊은 마음이 숨어 있기도 한가 봅니다."
  },
  {
   "spk": "나레이터",
   "text": "말없이 동생을 지킨 큰아들의 마음이 전해지셨다면, 구독과 좋아요 부탁드립니다."
  }
 ],
