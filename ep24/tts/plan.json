{
 "lines": [
  {
   "spk": "나레이터",
   "text": "농막 주말에만 빌려줬더니, 처남이 비밀번호를 바꿨습니다."
  },
  {
   "spk": "처남",
   "text": "\"매형은 평일에 쓰시면 되잖아요. 주말엔 저희 식구들이 와야 하니까.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 잠긴 농막 문 앞에서, 짧게 대답했습니다."
  },
  {
   "spk": "매형",
   "text": "\"그래? 그럼 다음 주에 열쇠 얘기 다시 하자.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 예순여덟, 퇴직하고 밭 오백 평을 일굽니다."
  },
  {
   "spk": "나레이터",
   "text": "밭 한쪽에, 퇴직금을 헐어 작은 농막을 하나 지었죠."
  },
  {
   "spk": "나레이터",
   "text": "땡볕에 일하다 잠깐 눕고, 비 오면 피하는 제 쉼터였어요."
  },
  {
   "spk": "나레이터",
   "text": "이 년 전, 아내의 막냇동생인 처남이 부탁을 해 왔습니다."
  },
  {
   "spk": "처남",
   "text": "\"매형, 주말에 하루만 애들 데리고 바람 좀 쐬게 해 주세요.\""
  },
  {
   "spk": "나레이터",
   "text": "아내 동생이라, 군말 없이 비밀번호를 알려 줬습니다."
  },
  {
   "spk": "나레이터",
   "text": "그런데 하루가 이틀이 되고, 이틀이 매주가 됐어요."
  },
  {
   "spk": "나레이터",
   "text": "처남네는 고기를 굽고, 술병과 쓰레기는 그대로 두고 갔습니다."
  },
  {
   "spk": "나레이터",
   "text": "월요일마다 그걸 치우는 건, 늘 제 몫이었죠."
  },
  {
   "spk": "나레이터",
   "text": "전기 요금은 몇 달 만에 세 배로 뛰었더라고요."
  },
  {
   "spk": "나레이터",
   "text": "그래도 처가 식구라, 싫은 소리 한 번 안 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그러다 지난 토요일, 고추를 따다 농막 문을 여는데 열리지 않았어요."
  },
  {
   "spk": "나레이터",
   "text": "비밀번호가 바뀌어 있었던 거죠."
  },
  {
   "spk": "나레이터",
   "text": "처남에게 전화를 걸었더니, 태연하게 이러더라고요."
  },
  {
   "spk": "처남",
   "text": "\"아, 매형 오시면 애들이 불편해해서요. 제가 바꿔 놨어요.\""
  },
  {
   "spk": "나레이터",
   "text": "제 땅에 지은 제 농막 앞에서, 저는 땡볕에 한 시간을 서 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그 순간, 마음이 딱 식었습니다."
  },
  {
   "spk": "나레이터",
   "text": "다음 주 토요일 아침, 저는 열쇠 가게 사장님과 같이 농막에 갔습니다."
  },
  {
   "spk": "나레이터",
   "text": "문 잠금장치부터 새것으로 바꿨어요. 비밀번호는 이제 저만 압니다."
  },
  {
   "spk": "나레이터",
   "text": "처남 식구들 짐은 상자 다섯 개에 담아, 농막 앞에 가지런히 내놓았죠."
  },
  {
   "spk": "나레이터",
   "text": "상자 맨 위에는, 이 년 치 전기 요금 고지서를 올려 두었습니다."
  },
  {
   "spk": "나레이터",
   "text": "점심때, 처남 식구들이 차를 타고 들어왔어요."
  },
  {
   "spk": "처남",
   "text": "\"매형, 이게 뭐예요? 애들 다 데리고 왔는데 문도 안 열리고.\""
  },
  {
   "spk": "매형",
   "text": "\"내가 빌려준 건 주말 하루 쉼터지, 네 별장 열쇠가 아니다.\""
  },
  {
   "spk": "매형",
   "text": "\"그 고지서는 이 년 치 전기 요금이다. 절반은 네가 내라.\""
  },
  {
   "spk": "처남",
   "text": "\"아니, 가족끼리 전기세 몇 푼 갖고 너무하시네요.\""
  },
  {
   "spk": "매형",
   "text": "\"가족이면, 매형을 땡볕에 한 시간씩 세워 두진 않지.\""
  },
  {
   "spk": "나레이터",
   "text": "옆에 있던 아내가, 처남을 보며 한마디 보탰습니다."
  },
  {
   "spk": "아내",
   "text": "\"너 그동안 매형한테 고맙다는 말 한 번 했니? 짐 싣고 가.\""
  },
  {
   "spk": "나레이터",
   "text": "처남은 아무 말도 못 하고, 상자를 하나씩 차에 실었어요."
  },
  {
   "spk": "나레이터",
   "text": "사흘 뒤, 전기 요금 반이 제 통장으로 들어왔더군요."
  },
  {
   "spk": "나레이터",
   "text": "지금 농막에는, 땀 식히는 제 의자 하나만 놓여 있죠."
  },
  {
   "spk": "나레이터",
   "text": "빌려준 열쇠는 언제든 돌려받을 수 있어야, 정도 오래가는 것 같습니다."
  },
  {
   "spk": "나레이터",
   "text": "여러분이라면 웃고 넘어가시겠습니까? 아니면 저처럼 문부터 바꾸시겠습니까?"
  },
  {
   "spk": "나레이터",
   "text": "속이 시원하셨다면, 구독과 좋아요로 응원해 주세요."
  }
 ],
