{
 "lines": [
  {
   "spk": "나레이터",
   "text": "딸네 대출 이자 삼 년 대 줬더니, 딸이 제 아내에게 꺼낸 말이 충격입니다."
  },
  {
   "spk": "딸",
   "text": "\"엄마는 어차피 집에서 노는데, 애 보는 게 뭐가 힘들어?\""
  },
  {
   "spk": "나레이터",
   "text": "저는 그 말을 듣고, 짧게 대답했습니다."
  },
  {
   "spk": "아버지",
   "text": "\"그래. 그럼 내일부터 네 엄마는 집에서 쉬라고 하마.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 예순여섯, 삼십 년 다닌 회사를 정년퇴직했습니다."
  },
  {
   "spk": "나레이터",
   "text": "삼 년 전 딸이 아파트를 사면서, 대출 이자가 버겁다고 울먹였죠."
  },
  {
   "spk": "나레이터",
   "text": "저는 연금에서 매달 육십만 원씩, 딸 통장으로 이자를 보내 줬습니다."
  },
  {
   "spk": "나레이터",
   "text": "아내는 일주일에 나흘, 버스를 두 번 갈아타고 가서 손주 둘을 봐 줬어요."
  },
  {
   "spk": "나레이터",
   "text": "아침 일곱 시에 가서, 사위가 퇴근하는 밤 여덟 시에야 돌아왔죠."
  },
  {
   "spk": "나레이터",
   "text": "그래도 딸은 고맙다는 말 대신 타박부터 했습니다."
  },
  {
   "spk": "딸",
   "text": "\"엄마, 애 옷을 왜 이렇게 입혔어? 반찬도 너무 짜잖아.\""
  },
  {
   "spk": "나레이터",
   "text": "사위는 아내가 차린 밥을 먹고도, 인사 한 번 제대로 안 했고요."
  },
  {
   "spk": "아내",
   "text": "\"손주 얼굴 보는 낙이지, 뭐. 당신은 신경 쓰지 마요.\""
  },
  {
   "spk": "나레이터",
   "text": "그러다 지난달, 아내 손목에 파스가 잔뜩 붙어 있는 걸 봤어요."
  },
  {
   "spk": "나레이터",
   "text": "손주를 안아 올리다가 손목 인대가 늘어났다더군요."
  },
  {
   "spk": "나레이터",
   "text": "저는 딸에게 전화를 걸어, 엄마를 한동안 쉬게 하자고 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그때 돌아온 대답이 바로, 집에서 노는데 뭐가 힘드냐는 말이었죠."
  },
  {
   "spk": "나레이터",
   "text": "그런데 딸은 전화를 끊기 전에, 한마디를 더 보탰습니다."
  },
  {
   "spk": "딸",
   "text": "\"그리고 아빠, 이자 오른 거 알지? 다음 달부터 이십만 원만 더 보내.\""
  },
  {
   "spk": "나레이터",
   "text": "그 말을 듣는 순간, 마음이 딱 식었습니다."
  },
  {
   "spk": "나레이터",
   "text": "다음 날 아침, 저는 은행에 가서 자동이체부터 해지했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그리고 삼 년 치 이체 내역을 뽑아 들고, 딸네 집으로 갔어요."
  },
  {
   "spk": "나레이터",
   "text": "서른여섯 번, 모두 이천백육십만 원이었죠."
  },
  {
   "spk": "나레이터",
   "text": "저는 그 종이를 식탁 위에 올려놓았습니다."
  },
  {
   "spk": "아버지",
   "text": "\"이 돈은 손주들 잘 키우라고 보낸 거지, 네 엄마 부려 먹으라고 보낸 게 아니다.\""
  },
  {
   "spk": "딸",
   "text": "\"아빠, 갑자기 왜 이래? 그럼 애는 누가 봐?\""
  },
  {
   "spk": "아버지",
   "text": "\"네 아이는 네가 키워라. 네 엄마는 오늘부터 내가 돌본다.\""
  },
  {
   "spk": "딸",
   "text": "\"이자 끊기면 우리 집은 어떡하라고!\""
  },
  {
   "spk": "아버지",
   "text": "\"그건 너희 부부가 알아서 할 일이다.\""
  },
  {
   "spk": "사위",
   "text": "\"장인어른, 그래도 이렇게까지 하실 일은…\""
  },
  {
   "spk": "나레이터",
   "text": "사위는 이체 내역을 내려다보더니, 말끝을 흐리더군요."
  },
  {
   "spk": "나레이터",
   "text": "저는 아내 가방을 챙겨 들고, 그 집 현관을 나왔습니다."
  },
  {
   "spk": "나레이터",
   "text": "돌아오는 버스에서, 아내는 제 손을 잡고 한참 창밖만 봤어요."
  },
  {
   "spk": "아내",
   "text": "\"여보, 사실은… 나 많이 힘들었어요.\""
  },
  {
   "spk": "나레이터",
   "text": "그 한마디에, 삼 년 동안 모른 척한 제가 부끄러웠어요."
  },
  {
   "spk": "나레이터",
   "text": "그 주말, 저는 처음으로 아내를 데리고 한의원에 가서, 손목에 침을 맞게 했죠."
  },
  {
   "spk": "나레이터",
   "text": "호의가 길어지면, 고마움이 당연함이 되기도 하나 봅니다."
  },
  {
   "spk": "나레이터",
   "text": "여러분이라면 그래도 이자를 계속 보내 주시겠어요, 아니면 저처럼 끊으시겠어요?"
  },
  {
   "spk": "나레이터",
   "text": "제 선택이 속 시원하셨다면, 구독과 좋아요 부탁드립니다."
  }
 ],
