{
 "lines": [
  {
   "spk": "나레이터",
   "text": "밥값 한 번 안 내던 남동생, 예순 생일에 온 우편 한 통에 울었습니다."
  },
  {
   "spk": "남동생",
   "text": "\"누나, 계산 좀 해 줘. 이번 달은 진짜 빠듯해서.\""
  },
  {
   "spk": "나레이터",
   "text": "십 년 동안 가족 밥상 끝에는, 늘 그 말이 따라왔습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 그런 동생이 참 얄미웠어요."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 예순, 결혼하지 않고 시장에서 이십 년째 반찬가게를 합니다."
  },
  {
   "spk": "나레이터",
   "text": "젊어서는 동생 학비를 대느라, 시집갈 때를 놓쳤죠."
  },
  {
   "spk": "나레이터",
   "text": "다섯 살 아래 동생은 택시를 몰며 아이 둘을 키웁니다."
  },
  {
   "spk": "나레이터",
   "text": "어머니 생신에도, 명절 외식에도 계산은 늘 제 몫이었어요."
  },
  {
   "spk": "남동생",
   "text": "\"누나가 제일 잘 벌잖아. 다음엔 내가 낼게.\""
  },
  {
   "spk": "나레이터",
   "text": "동생은 몇 년째 같은 점퍼만 입고, 돈 없다는 소리를 입에 달고 살았습니다."
  },
  {
   "spk": "나레이터",
   "text": "제가 허리 수술을 받았을 때도, 빈손으로 한 번 다녀간 게 다였죠."
  },
  {
   "spk": "남동생",
   "text": "\"누나, 몸조리 잘해. 나 일 나가 봐야 돼.\""
  },
  {
   "spk": "누나",
   "text": "\"너는 누나가 무슨 은행인 줄 아니?\""
  },
  {
   "spk": "남동생",
   "text": "\"미안해, 누나. 나중에 한 번에 갚을게.\""
  },
  {
   "spk": "나레이터",
   "text": "그 나중이 대체 언제냐고, 속으로만 몇 번을 삼켰는지 모릅니다."
  },
  {
   "spk": "나레이터",
   "text": "혼자 늙어 갈 생각을 하면, 그 돈 한 푼이 아쉬웠거든요."
  },
  {
   "spk": "나레이터",
   "text": "가게 형편이 어려워서, 저는 연금 한 번 부어 본 적이 없었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그러다 지난달, 예순 생일에 국민연금공단에서 봉투가 하나 왔어요."
  },
  {
   "spk": "나레이터",
   "text": "그동안 낸 연금 내역을 알려 주는 안내문이었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그런데 한 번도 안 낸 연금이, 십 년 동안 한 달도 빠짐없이 들어가 있었죠."
  },
  {
   "spk": "나레이터",
   "text": "연금을 낸 사람 칸에는, 동생 이름이 적혀 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "십 년 전, 동생이 서류 한 장에 사인만 해 달라던 날이 그제야 떠올랐어요."
  },
  {
   "spk": "나레이터",
   "text": "한 달에 이십만 원씩, 십 년이면 이천사백만 원입니다."
  },
  {
   "spk": "나레이터",
   "text": "그날 밤, 저는 안내문을 들고 동생 집으로 찾아갔습니다."
  },
  {
   "spk": "누나",
   "text": "\"너, 이게 대체 어떻게 된 거야?\""
  },
  {
   "spk": "남동생",
   "text": "\"누나는 우리 뒷바라지하느라 시집도 못 갔잖아. 늙어서 빈손이면 안 되지.\""
  },
  {
   "spk": "남동생",
   "text": "\"누나가 사 준 밥값만큼 아껴서 낸 거야. 그래서 맨날 얻어먹었지, 뭐.\""
  },
  {
   "spk": "누나",
   "text": "\"이 바보야, 니 애들 학원비는 어쩌고…\""
  },
  {
   "spk": "남동생",
   "text": "\"집사람도 다 알아. 둘이 같이 아낀 거야.\""
  },
  {
   "spk": "나레이터",
   "text": "늘 빠듯하다던 동생의 돈이, 전부 제 노후로 가고 있었던 거죠."
  },
  {
   "spk": "남동생",
   "text": "\"이번에는 누나가 계산하지 말고, 받기만 해.\""
  },
  {
   "spk": "나레이터",
   "text": "그렇게 말하는 동생의 점퍼 소매는, 다 해져 있었어요."
  },
  {
   "spk": "나레이터",
   "text": "저는 안내문을 손에 쥔 채, 한참을 울었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그제야 알았습니다. 동생은 염치가 없었던 게 아니라, 제 늙은 날을 몰래 채우고 있었던 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "그 주말, 저는 처음으로 동생에게 새 점퍼 한 벌을 사 줬어요."
  },
  {
   "spk": "누나",
   "text": "\"점퍼는 누나가 샀으니까, 밥은 니가 사.\""
  },
  {
   "spk": "나레이터",
   "text": "가장 가까운 가족의 마음은, 늘 가장 늦게 보이는 것 같습니다."
  },
  {
   "spk": "나레이터",
   "text": "요즘 동생은 밥을 다 먹고 나면, 저보다 먼저 계산대로 걸어갑니다."
  }
 ],
