{
 "lines": [
  {
   "spk": "나레이터",
   "text": "측량하던 날, 이장님이 꺼낸 영수증 앞에서 저는 고개를 들 수 없었습니다."
  },
  {
   "spk": "나레이터",
   "text": "작년에 돌아가신 아버지가 충남 시골 밭 이백 평을 남기셨습니다."
  },
  {
   "spk": "나레이터",
   "text": "길도 없는 맹지라 다들 쓸모없는 땅이라고 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그런데 올봄, 그 땅에 도로가 난다며 보상금 육천만 원 통지서가 왔습니다."
  },
  {
   "spk": "나레이터",
   "text": "서류를 내기 전에 땅이라도 한번 보려고 내려갔습니다."
  },
  {
   "spk": "나레이터",
   "text": "풀만 자라 있을 줄 알았던 밭에, 울타리가 둘러져 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그 안에 컨테이너 집 한 채와 고추밭이 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "문을 두드리자 일흔쯤 되신 할머니가 나오셨습니다."
  },
  {
   "spk": "할머니",
   "text": "\"누구신데 남의 집 마당에 들어오세요?\""
  },
  {
   "spk": "나레이터",
   "text": "등기부를 보여 드리며 아버지 땅이라고 말씀드렸습니다."
  },
  {
   "spk": "할머니",
   "text": "\"내가 여기서 이십 년 넘게 농사를 지었어요. 아무한테나 못 내줍니다.\""
  },
  {
   "spk": "나레이터",
   "text": "남의 땅도 이십 년을 쓰면 자기 것이 된다는 말이 떠올랐습니다."
  },
  {
   "spk": "나레이터",
   "text": "아버지가 늘 '우리 경숙이 몫'이라고 하시던 땅이었습니다."
  },
  {
   "spk": "나레이터",
   "text": "할머니가 한마디를 더 하셨습니다."
  },
  {
   "spk": "할머니",
   "text": "\"따님 얼굴은 한 번도 못 봤어요. 돈 나온다니까 이제야 오셨네요.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 그 말이 보상금을 노린 억지라고만 생각했습니다."
  },
  {
   "spk": "나레이터",
   "text": "다음 날, 할머니를 내보내려고 군청에 측량을 신청했습니다."
  },
  {
   "spk": "나레이터",
   "text": "측량하던 날, 이장님이 비닐봉지 하나를 들고 오셨습니다."
  },
  {
   "spk": "이장",
   "text": "\"경숙 씨, 이 땅 세금은 아버님이 내신 게 아닙니다.\""
  },
  {
   "spk": "나레이터",
   "text": "봉지 안에는 십오 년 치 재산세 영수증이 들어 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "영수증마다 귀퉁이에 연필로 '옥순 냄'이라고 적혀 있었습니다."
  },
  {
   "spk": "이장",
   "text": "\"아버님이 요양병원에 가신 뒤로, 저 어르신이 대신 내 오셨지요.\""
  },
  {
   "spk": "이장",
   "text": "\"삼 년 전 어르신이 집을 잃으셨을 때, 아버님이 밭에 와서 사시라고 하셨고요.\""
  },
  {
   "spk": "나레이터",
   "text": "해마다 가을이면, 아버지 이름으로 고춧가루 한 봉지가 왔습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 그게 아버지가 장에서 사 보내시는 건 줄로만 알았습니다."
  },
  {
   "spk": "나레이터",
   "text": "요양병원에 누워 계신 분이 어떻게 보내셨는지, 한 번도 여쭤보지 않았습니다."
  },
  {
   "spk": "나레이터",
   "text": "이장님이 할머니가 맡기고 가신 쪽지 한 장을 더 내미셨습니다."
  },
  {
   "spk": "나레이터",
   "text": "'보상금은 경숙이 몫'이라는, 삐뚤빼뚤한 글씨였습니다."
  },
  {
   "spk": "나레이터",
   "text": "아버지가 하시던 말 그대로였습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 그 자리에서 아무 말도 하지 못했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그날 저녁 다시 밭에 가 보니, 컨테이너 앞에 보따리 두 개가 묶여 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 말없이 그 보따리 끈을 풀었습니다."
  },
  {
   "spk": "이경숙",
   "text": "\"할머니… 죄송합니다. 그냥 여기 계셔 주세요.\""
  },
  {
   "spk": "할머니",
   "text": "\"고춧가루는… 올해도 보낼게요.\""
  },
  {
   "spk": "나레이터",
   "text": "다들 쓸모없다던 그 땅은, 아버지와 할머니가 이십 년을 지켜 온 땅이었습니다."
  },
  {
   "spk": "나레이터",
   "text": "여러분이라면 그 할머니께 무슨 말씀을 드리시겠습니까?"
  },
  {
   "spk": "나레이터",
   "text": "공감되셨다면 구독과 좋아요 부탁드립니다."
  }
 ],
