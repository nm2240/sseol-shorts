{
 "lines": [
  {
   "spk": "나레이터",
   "text": "아파트가 편하다던 어머니, 팔린 시골집 새 주인이 한 말에 결국 울었습니다."
  },
  {
   "spk": "어머니",
   "text": "\"집 팔자. 혼자 마당 건사하기도 힘들고, 이제 아파트가 편하다.\""
  },
  {
   "spk": "나레이터",
   "text": "아버지 돌아가시고 이 년째 되던 봄, 어머니가 먼저 꺼내신 말이었어요."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 쉰넷입니다."
  },
  {
   "spk": "나레이터",
   "text": "작은 인테리어 가게를 하다가 작년에 빚이 삼천만 원 생겼죠."
  },
  {
   "spk": "나레이터",
   "text": "어머니는 집 판 돈으로 저희 동네 작은 아파트에 전세를 얻으셨습니다."
  },
  {
   "spk": "나레이터",
   "text": "남은 돈 이천만 원은 저한테 내미셨고요."
  },
  {
   "spk": "어머니",
   "text": "\"어차피 니 몫이다. 일찍 받는다 생각해.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 어머니가 정말 아파트를 좋아하시는 줄 알았습니다."
  },
  {
   "spk": "나레이터",
   "text": "엘리베이터 있어 편하다, 마트 가까워 좋다, 전화할 때마다 그러셨으니까요."
  },
  {
   "spk": "나레이터",
   "text": "그런데 이사하고 얼마 안 돼서부터 어머니가 이상해지셨어요."
  },
  {
   "spk": "나레이터",
   "text": "아침마다 집에 안 계시고, 전화도 잘 안 받으셨거든요."
  },
  {
   "spk": "아내",
   "text": "\"어머님, 요즘 아침마다 어디 다녀오세요?\""
  },
  {
   "spk": "어머니",
   "text": "\"그냥 운동 삼아 좀 걷는다.\""
  },
  {
   "spk": "나레이터",
   "text": "저녁 같이 먹자고 해도 피곤하다며 일찍 들어가셨습니다."
  },
  {
   "spk": "나레이터",
   "text": "혹시 이상한 데 다니시나, 아니면 기억이 흐려지시나 덜컥 겁이 났죠."
  },
  {
   "spk": "나레이터",
   "text": "그러다 석 달째 되던 날, 모르는 번호로 전화가 왔습니다."
  },
  {
   "spk": "새 주인",
   "text": "\"혹시 할머님 아드님 되세요? 할머님이 매일 아침 저희 집 마당에 와 계셔서요.\""
  },
  {
   "spk": "나레이터",
   "text": "시골집을 산 젊은 귀농 부부였습니다."
  },
  {
   "spk": "나레이터",
   "text": "다음 날 새벽, 저는 차를 몰고 내려갔어요."
  },
  {
   "spk": "나레이터",
   "text": "어머니는 마당 감나무 밑 평상에 앉아, 텃밭 고추에 물을 주고 계셨습니다."
  },
  {
   "spk": "나레이터",
   "text": "새 주인이 조심스럽게 쪽지 한 장을 내밀었습니다."
  },
  {
   "spk": "나레이터",
   "text": "집을 팔던 날 어머니가 써 주신 거라고 했어요."
  },
  {
   "spk": "나레이터",
   "text": "'감나무랑 텃밭은 그대로 둬 주시면 고맙겠습니다. 우리 영감이 심은 겁니다.'"
  },
  {
   "spk": "새 주인",
   "text": "\"계약하시던 날 많이 우셨어요. 아들 빚만 아니면 안 판다고 하시면서요.\""
  },
  {
   "spk": "나레이터",
   "text": "어머니는 아파트가 편해서 집을 내놓으신 게 아니었던 거죠."
  },
  {
   "spk": "어머니",
   "text": "\"니 빚 때문이라고 하면 니가 안 받을 것 같아서 그랬다.\""
  },
  {
   "spk": "어머니",
   "text": "\"아파트도 좋다. 그냥 니 아버지 감나무가 보고 싶어서 왔다.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 평상에 주저앉은 채 한참을 울었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그제야 깨달았습니다."
  },
  {
   "spk": "나레이터",
   "text": "어머니는 평생 사시던 마당을 내놓고, 그 대신 제 가게를 지켜 주신 겁니다."
  },
  {
   "spk": "아들",
   "text": "\"어머니, 이번에는 제가 어머니 마당을 찾아 드릴게요.\""
  },
  {
   "spk": "나레이터",
   "text": "사정을 들은 새 주인 부부가 먼저 말을 꺼냈어요."
  },
  {
   "spk": "새 주인",
   "text": "\"텃밭 한쪽은 계속 할머님이 가꿔 주세요. 저희도 배울 게 많아요.\""
  },
  {
   "spk": "나레이터",
   "text": "그 뒤로 저는 토요일마다 어머니를 모시고 시골집에 갑니다."
  },
  {
   "spk": "나레이터",
   "text": "그 마당에만 가면 어머니 얼굴이 환해지세요."
  },
  {
   "spk": "나레이터",
   "text": "그리고 매달 조금씩, 그 이천만 원을 어머니 이름으로 다시 모으고 있죠."
  },
  {
   "spk": "나레이터",
   "text": "부모의 괜찮다는 말은, 때로 가장 큰 거짓말인 것 같습니다."
  },
  {
   "spk": "나레이터",
   "text": "어머니의 깊은 마음이 공감되셨다면 구독과 좋아요 부탁드립니다."
  }
 ],
