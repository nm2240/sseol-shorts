{
 "lines": [
  {
   "spk": "나레이터",
   "text": "추석마다 시댁 일로 못 온다던 딸, 새벽 대문 앞에서 그 모습을 보고 결국 울었습니다."
  },
  {
   "spk": "수진",
   "text": "\"엄마, 이번 추석도 못 가요. 미안해.\""
  },
  {
   "spk": "나레이터",
   "text": "벌써 오 년째 듣는 말입니다."
  },
  {
   "spk": "나레이터",
   "text": "전화는 늘 짧았습니다."
  },
  {
   "spk": "나레이터",
   "text": "시댁 어른들 상 차려야 한다며 금방 끊었습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 괜찮다고, 잘 지내라고만 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 예순여덟입니다."
  },
  {
   "spk": "나레이터",
   "text": "남편을 먼저 보내고 시골집에서 혼자 삽니다."
  },
  {
   "spk": "나레이터",
   "text": "딸 하나 서울로 시집보내고, 명절만 기다리며 살았습니다."
  },
  {
   "spk": "나레이터",
   "text": "동네 사람들은 저를 부러워합니다."
  },
  {
   "spk": "옆집 할머니",
   "text": "\"수진이 엄마는 좋겠어. 딸이 서울 부잣집으로 시집갔잖아.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 웃기만 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "딸 얼굴을 못 본 지 오 년이 됐다는 말은 차마 못 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그런데 추석날 아침마다 대문 앞에 송편 한 봉지와 봉투가 놓여 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "이름도 없이요."
  },
  {
   "spk": "나레이터",
   "text": "봉투에는 만 원짜리 열 장이 들어 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "딸이 사람을 시켜 보낸 줄로만 알았습니다."
  },
  {
   "spk": "나레이터",
   "text": "얼굴 한 번 보여 주는 게 그렇게 어려운가, 저는 그 봉투가 서운했습니다."
  },
  {
   "spk": "나레이터",
   "text": "올해는 불을 끄고 기다렸습니다."
  },
  {
   "spk": "나레이터",
   "text": "누가 두고 가는지, 꼭 한번 보고 싶었습니다."
  },
  {
   "spk": "나레이터",
   "text": "새벽 다섯 시, 문틈으로 내다보니 한 여자가 무릎을 꿇고 절을 하고 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "휴게소 식당 유니폼을 입은 채로요."
  },
  {
   "spk": "엄마",
   "text": "\"수진아?\""
  },
  {
   "spk": "수진",
   "text": "\"엄마… 왜 안 자고…\""
  },
  {
   "spk": "나레이터",
   "text": "딸은 무릎을 꿇은 채로 고개만 숙였습니다."
  },
  {
   "spk": "나레이터",
   "text": "손을 잡았는데 거칠고 갈라진 손이었습니다."
  },
  {
   "spk": "나레이터",
   "text": "시집갈 때만 해도 곱던 손이었습니다."
  },
  {
   "spk": "엄마",
   "text": "\"너 꼴이 이게 뭐야. 김 서방은 어디 있고?\""
  },
  {
   "spk": "수진",
   "text": "\"엄마, 나 오 년 전에 이혼했어.\""
  },
  {
   "spk": "나레이터",
   "text": "혼자 먹고살려고 고속도로 휴게소 식당에 들어갔답니다."
  },
  {
   "spk": "나레이터",
   "text": "명절엔 손님이 제일 많아 쉴 수가 없고요."
  },
  {
   "spk": "나레이터",
   "text": "남들 쉬는 날이 딸한테는 제일 바쁜 날이었습니다."
  },
  {
   "spk": "나레이터",
   "text": "밤 근무가 끝나면 두 시간을 달려와 절 한 번 올리고, 아침 근무에 맞춰 돌아갔던 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "송편은 휴게소 주방에서 일 끝나고 직접 빚은 거였습니다."
  },
  {
   "spk": "나레이터",
   "text": "봉투는 명절 야간 근무 수당이었습니다."
  },
  {
   "spk": "수진",
   "text": "\"동네에서 엄마 딸 시집 잘 갔다고 하잖아. 엄마가 걱정할까 봐…\""
  },
  {
   "spk": "엄마",
   "text": "\"이 바보야. 남들 입이 뭐가 중요해. 네가 고생하는 줄도 모르고 웃고 다닌 엄마가 죄인이지.\""
  },
  {
   "spk": "나레이터",
   "text": "그날 새벽, 딸에게 따뜻한 밥 한 상을 차려 줬습니다."
  },
  {
   "spk": "나레이터",
   "text": "추석에 먹으려고 재워 둔 갈비를 꺼내 데웠습니다."
  },
  {
   "spk": "나레이터",
   "text": "딸은 숟가락을 들다 말고 어린애처럼 울었습니다."
  },
  {
   "spk": "나레이터",
   "text": "아침 여섯 시, 딸은 근무에 맞춰 다시 차에 올랐습니다."
  },
  {
   "spk": "나레이터",
   "text": "올해는 처음으로, 제가 대문 앞에 서서 딸을 배웅했습니다."
  },
  {
   "spk": "나레이터",
   "text": "차가 안 보일 때까지 한참을 서 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그 뒤로 딸은 일요일 저녁마다 전화를 합니다."
  },
  {
   "spk": "나레이터",
   "text": "며칠 뒤 옆집 할머니가 또 물었습니다."
  },
  {
   "spk": "옆집 할머니",
   "text": "\"수진이는 잘 산대?\""
  },
  {
   "spk": "엄마",
   "text": "\"그럼요. 혼자서도 누구보다 열심히 사는 애예요.\""
  },
  {
   "spk": "나레이터",
   "text": "이번에는 웃기만 하지 않았습니다."
  },
  {
   "spk": "나레이터",
   "text": "부모가 보고 싶은 건 잘사는 자식이 아니라, 어쩌면 그냥 자식 얼굴인지도 모르겠습니다."
  },
  {
   "spk": "나레이터",
   "text": "오늘 부모님께 전화 한 통 드려 보세요."
  },
  {
   "spk": "나레이터",
   "text": "공감하셨다면 구독과 좋아요 부탁드립니다."
  }
 ],
