{
 "lines": [
  {
   "spk": "나레이터",
   "text": "장인어른이 일당 주겠다며 배추밭에 부른 날, 봉투 속 쪽지를 보고 결국 울었습니다."
  },
  {
   "spk": "장인",
   "text": "\"자네, 배추 뽑을 일손이 없네. 일당 십오만 원 줌세. 평일에 올 수 있겠나?\""
  },
  {
   "spk": "나레이터",
   "text": "지난 시월, 장인어른이 처음으로 저한테 건 전화였어요."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 쉰하나입니다."
  },
  {
   "spk": "나레이터",
   "text": "이십 년 다닌 회사에서 올해 봄에 권고사직을 받았습니다."
  },
  {
   "spk": "나레이터",
   "text": "아내한테는 차마 말을 못 했죠."
  },
  {
   "spk": "나레이터",
   "text": "석 달째 아침마다 양복을 입고 나가 도서관에서 하루를 보냈습니다."
  },
  {
   "spk": "나레이터",
   "text": "장인어른은 결혼 때부터 저를 탐탁지 않아 하셨어요."
  },
  {
   "spk": "나레이터",
   "text": "이십 년 동안 밥 한 번 같이 먹자는 말씀이 없으셨거든요."
  },
  {
   "spk": "나레이터",
   "text": "그런 분이 일당을 주겠다고 하시니 속이 상했습니다."
  },
  {
   "spk": "나레이터",
   "text": "사위를 일꾼으로 부르시는구나 싶었죠."
  },
  {
   "spk": "나레이터",
   "text": "그래도 그 돈이 아쉬워서, 회사에 연차를 냈다고 하고 내려갔습니다."
  },
  {
   "spk": "아내",
   "text": "\"아빠 밭일 힘들 텐데, 장갑 두 켤레 챙겨 가.\""
  },
  {
   "spk": "나레이터",
   "text": "이틀 동안 배추를 뽑고, 겉잎을 다듬고, 트럭까지 날랐어요."
  },
  {
   "spk": "나레이터",
   "text": "장인어른은 일하는 내내 말씀이 없으셨습니다."
  },
  {
   "spk": "장인",
   "text": "\"허리 펴지 말게. 해 지기 전에 끝내야 하네.\""
  },
  {
   "spk": "나레이터",
   "text": "자고 가라는 말씀도 없으셔서, 첫날 밤은 읍내 찜질방에서 잤어요."
  },
  {
   "spk": "아내",
   "text": "\"아빠가 당신 일 잘한대. 내일도 꼭 와 달래.\""
  },
  {
   "spk": "나레이터",
   "text": "점심도 밭두렁에 앉아 컵라면 하나로 때웠죠."
  },
  {
   "spk": "나레이터",
   "text": "둘째 날 해 질 무렵, 장인어른이 흰 봉투를 내미셨습니다."
  },
  {
   "spk": "장인",
   "text": "\"약속한 일당일세. 받아 두게.\""
  },
  {
   "spk": "사위",
   "text": "\"예… 잘 받겠습니다.\""
  },
  {
   "spk": "나레이터",
   "text": "결국 일꾼 값이구나 싶어서, 고맙다는 말도 안 나오더라고요."
  },
  {
   "spk": "나레이터",
   "text": "집에 가는 길, 휴게소에서 봉투를 열어 봤습니다."
  },
  {
   "spk": "나레이터",
   "text": "봉투 안에는 삼십만 원과 통장 하나, 그리고 쪽지가 들어 있었어요."
  },
  {
   "spk": "나레이터",
   "text": "통장에는 오백만 원이 찍혀 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "쪽지에는 장인어른 글씨가 꾹꾹 눌러 적혀 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "'자네 일은 딸한테 들었네. 처가에 손 벌리기 싫은 마음 아네. 그래서 일당으로 주는 걸세.'"
  },
  {
   "spk": "나레이터",
   "text": "아내는 이미 다 알고 있었던 거죠."
  },
  {
   "spk": "나레이터",
   "text": "저는 휴게소 주차장에서 한참을 울었습니다."
  },
  {
   "spk": "나레이터",
   "text": "그날 밤, 아내가 아무렇지 않게 말했어요."
  },
  {
   "spk": "아내",
   "text": "\"아빠도 마흔둘에 공장 문 닫았을 때, 외할아버지가 이렇게 밭에 불러 주셨대. 그러니까 기죽지 마.\""
  },
  {
   "spk": "나레이터",
   "text": "다음 날 장인어른께 전화를 드렸습니다."
  },
  {
   "spk": "사위",
   "text": "\"장인어른, 이 돈은 못 받겠습니다.\""
  },
  {
   "spk": "장인",
   "text": "\"받게. 이번에는 자네가 받을 차례고, 나중에 자네 사위한테 갚으면 되네.\""
  },
  {
   "spk": "나레이터",
   "text": "그제야 깨달았습니다."
  },
  {
   "spk": "나레이터",
   "text": "장인어른은 저를 일꾼으로 부르신 게 아니라, 제 자존심이 다치지 않을 길을 찾고 계셨던 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "석 달 뒤 저는 작은 물류 회사에 다시 들어갔어요."
  },
  {
   "spk": "나레이터",
   "text": "첫 월급으로 장화 한 켤레를 사 들고 처가에 내려갔죠."
  },
  {
   "spk": "나레이터",
   "text": "그날 처음으로 장인어른이 막걸리를 따라 주시더라고요."
  },
  {
   "spk": "나레이터",
   "text": "장인어른이 따라 주신 그 막걸리 맛은 아마 평생 못 잊을 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "곁에 말없이 등을 받쳐 주는 어른이 계시다면, 오늘은 먼저 고맙다고 말씀드려 보세요."
  },
  {
   "spk": "나레이터",
   "text": "구독과 좋아요로 응원해 주세요."
  }
 ],
