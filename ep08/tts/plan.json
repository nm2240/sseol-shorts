{
 "lines": [
  {
   "spk": "나레이터",
   "text": "새 집 문 앞에 매주 놓인 반찬 봉지, 카메라에 찍힌 사람을 보고 결국 울었습니다."
  },
  {
   "spk": "아버지",
   "text": "\"이혼이 무슨 자랑이냐. 다시는 연락하지 마라.\""
  },
  {
   "spk": "나레이터",
   "text": "삼 년 전, 아버지가 제게 마지막으로 하신 말입니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 마흔다섯이에요."
  },
  {
   "spk": "나레이터",
   "text": "이혼하고 아홉 살 딸 서윤이를 혼자 키웁니다."
  },
  {
   "spk": "나레이터",
   "text": "그날 이후 저도 아버지께 전화하지 않았습니다."
  },
  {
   "spk": "나레이터",
   "text": "올봄, 작은 빌라로 이사를 했어요."
  },
  {
   "spk": "나레이터",
   "text": "그런데 이사하고 첫 일요일 아침, 현관 앞에 검은 봉지 하나가 놓여 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "장조림, 멸치볶음, 그리고 서윤이가 좋아하는 약과였어요."
  },
  {
   "spk": "나레이터",
   "text": "그 뒤로 봉지는 매주 어김없이 놓여 있었습니다."
  },
  {
   "spk": "손녀",
   "text": "\"엄마, 이거 누가 갖다 놓는 거야? 산타 할아버지야?\""
  },
  {
   "spk": "나레이터",
   "text": "아이는 신이 났지만, 저는 등골이 서늘했죠."
  },
  {
   "spk": "엄마",
   "text": "\"서윤아, 누가 준 건지 모르니까 아직 먹지 마.\""
  },
  {
   "spk": "나레이터",
   "text": "이사 온 걸 아는 사람이 거의 없었거든요."
  },
  {
   "spk": "나레이터",
   "text": "그런데 장조림을 한 입 먹고는 숟가락을 내려놓았습니다."
  },
  {
   "spk": "나레이터",
   "text": "돌아가신 엄마가 해 주던 그 맛이었어요."
  },
  {
   "spk": "나레이터",
   "text": "결국 현관 위에 작은 카메라를 달았습니다."
  },
  {
   "spk": "나레이터",
   "text": "일요일 새벽 다섯 시 반, 화면에 모자를 눌러쓴 노인이 나타났어요."
  },
  {
   "spk": "나레이터",
   "text": "봉지를 내려놓고는, 한참을 문 앞에 서 있다가 돌아서더라고요."
  },
  {
   "spk": "나레이터",
   "text": "그 굽은 등을 저는 한눈에 알아봤습니다."
  },
  {
   "spk": "나레이터",
   "text": "아버지였습니다."
  },
  {
   "spk": "나레이터",
   "text": "남동생에게 물었더니, 머뭇거리다 털어놓더군요."
  },
  {
   "spk": "남동생",
   "text": "\"누나, 아버지가 누나 주소 물어보셨어. 첫차 타고 두 시간씩 다니신대.\""
  },
  {
   "spk": "남동생",
   "text": "\"누나한테는 절대 말하지 말라고 하셨는데…\""
  },
  {
   "spk": "나레이터",
   "text": "그 주말, 저는 서윤이를 데리고 삼 년 만에 친정에 갔습니다."
  },
  {
   "spk": "나레이터",
   "text": "부엌 벽에 엄마의 낡은 반찬 수첩이 펼쳐져 붙어 있었어요."
  },
  {
   "spk": "나레이터",
   "text": "엄마 글씨 옆에, 삐뚤빼뚤한 아버지 글씨가 덧붙어 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "'장조림 간장 세 숟갈 반. 서윤이는 단 걸 좋아함.'"
  },
  {
   "spk": "나레이터",
   "text": "평생 라면 하나 안 끓이던 분이 엄마 수첩으로 반찬을 배우신 거죠."
  },
  {
   "spk": "아버지",
   "text": "\"니 엄마 같았으면, 너 힘들 때 반찬부터 싸 들고 갔을 거다.\""
  },
  {
   "spk": "아버지",
   "text": "\"나는 그때 그 말밖에 못 했다. 이번에는 니 엄마 대신 내가 해 보려고 했다.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 아버지 손을 잡고 아무 말도 못 했습니다."
  },
  {
   "spk": "손녀",
   "text": "\"할아버지가 산타 할아버지였구나!\""
  },
  {
   "spk": "나레이터",
   "text": "그제야 깨달았습니다."
  },
  {
   "spk": "나레이터",
   "text": "아버지는 저를 창피해한 게 아니라, 미안한 마음을 반찬으로밖에 전할 줄 모르셨던 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "그다음 일요일, 저는 새벽에 문을 열어 놓고 기다렸어요."
  },
  {
   "spk": "아버지",
   "text": "\"…들어가도 되겠냐?\""
  },
  {
   "spk": "딸",
   "text": "\"그럼요, 아버지. 진지 드시고 가세요.\""
  },
  {
   "spk": "나레이터",
   "text": "그날 처음으로 셋이서 아침을 먹었죠."
  },
  {
   "spk": "나레이터",
   "text": "말이 서툰 부모는 손으로 사랑을 하는 것 같습니다."
  },
  {
   "spk": "나레이터",
   "text": "여러분 집 문 앞에 그런 봉지가 놓여 있다면, 어떤 마음이 드실 것 같으세요?"
  },
  {
   "spk": "나레이터",
   "text": "따뜻한 한마디 댓글로 남겨 주세요."
  }
 ],
