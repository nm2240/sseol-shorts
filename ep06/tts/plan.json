{
 "lines": [
  {
   "spk": "나레이터",
   "text": "등록금 대 준 손녀가 연락 한 번 없더니, 아내 요양병원에서 그 모습을 보고 울었습니다."
  },
  {
   "spk": "손녀",
   "text": "\"할아버지, 이 돈 꼭 갚을게요. 간호사 돼서 꼭요.\""
  },
  {
   "spk": "나레이터",
   "text": "육 년 전, 손녀 지원이가 제 손을 잡고 한 말입니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 올해 일흔셋입니다."
  },
  {
   "spk": "나레이터",
   "text": "삼십 년 하던 철물점을 접고 받은 돈으로, 손녀 간호학과 등록금 이천팔백만 원을 댔어요."
  },
  {
   "spk": "나레이터",
   "text": "아들이 사업에 실패해서 손녀가 대학을 포기하려던 참이었거든요."
  },
  {
   "spk": "나레이터",
   "text": "아내가 치매로 요양병원에 들어간 것도 그 무렵이었죠."
  },
  {
   "spk": "나레이터",
   "text": "손녀는 졸업하고 큰 대학병원에 들어갔다고 했습니다."
  },
  {
   "spk": "나레이터",
   "text": "그런데 그 뒤로 연락이 뚝 끊겼어요."
  },
  {
   "spk": "나레이터",
   "text": "명절에도, 제 생일에도 문자 한 통이 전부였죠."
  },
  {
   "spk": "손녀",
   "text": "\"할아버지, 생신 축하드려요. 근무라서 못 가요. 죄송해요.\""
  },
  {
   "spk": "나레이터",
   "text": "서운한 마음에 아들한테 한마디 했습니다."
  },
  {
   "spk": "할아버지",
   "text": "\"지원이는 이제 할애비 얼굴도 잊어버린 게냐?\""
  },
  {
   "spk": "아들",
   "text": "\"아버지, 걔도 요즘 밤낮없이 바빠요.\""
  },
  {
   "spk": "나레이터",
   "text": "아들은 늘 그 말뿐이었죠."
  },
  {
   "spk": "나레이터",
   "text": "공부시켜 놨더니 할애비는 잊었구나, 혼자 그렇게 서운해했습니다."
  },
  {
   "spk": "나레이터",
   "text": "저는 일요일 낮마다 아내를 보러 요양병원에 갑니다."
  },
  {
   "spk": "나레이터",
   "text": "아내는 저를 못 알아볼 때가 더 많습니다."
  },
  {
   "spk": "나레이터",
   "text": "그래도 손을 잡고 있으면 가끔 웃어 주거든요."
  },
  {
   "spk": "나레이터",
   "text": "그렇게 이 년이 흘렀습니다."
  },
  {
   "spk": "나레이터",
   "text": "지난달 밤 열한 시, 요양병원에서 전화가 왔습니다."
  },
  {
   "spk": "수간호사",
   "text": "\"어르신, 할머님이 열이 많이 나세요. 와 보셔야겠어요.\""
  },
  {
   "spk": "나레이터",
   "text": "택시를 잡아타고 가는 내내 손이 떨렸어요."
  },
  {
   "spk": "나레이터",
   "text": "병실 문을 열었더니, 간호사 한 명이 아내 이마에 물수건을 얹고 있더라고요."
  },
  {
   "spk": "나레이터",
   "text": "고개를 든 간호사 얼굴을 보고, 저는 그 자리에 굳어 버렸습니다."
  },
  {
   "spk": "할아버지",
   "text": "\"지원아… 네가 왜 여기 있어?\""
  },
  {
   "spk": "아내",
   "text": "\"우리 지원이… 밤마다 오는 애야.\""
  },
  {
   "spk": "나레이터",
   "text": "저를 못 알아보는 아내가, 손녀 이름은 부르고 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "손녀는 대학병원을 일 년 만에 그만두고, 이 요양병원으로 옮겨 왔대요."
  },
  {
   "spk": "나레이터",
   "text": "일요일 낮엔 제가 오니까, 자기는 평일 밤 근무만 맡았다고 했어요."
  },
  {
   "spk": "수간호사",
   "text": "\"지원 선생님이 할아버님께는 절대 말하지 말아 달라고 했어요.\""
  },
  {
   "spk": "나레이터",
   "text": "손녀가 가운 주머니에서 작은 수첩을 꺼냈습니다."
  },
  {
   "spk": "나레이터",
   "text": "이 년 동안 하루도 빠짐없이 적혀 있었습니다."
  },
  {
   "spk": "나레이터",
   "text": "'할머니 오늘 죽 반 그릇. 할아버지 얘기하니까 웃으심.'"
  },
  {
   "spk": "손녀",
   "text": "\"할아버지가 대학 보내 주셨잖아요. 그렇게 배운 걸 할머니한테 제일 먼저 쓰고 싶었어요.\""
  },
  {
   "spk": "손녀",
   "text": "\"이번에는 제가 할아버지 대신 할머니 밤을 지켜 드리고 싶었어요.\""
  },
  {
   "spk": "나레이터",
   "text": "저는 손녀를 끌어안고 한참을 울었습니다."
  },
  {
   "spk": "나레이터",
   "text": "아들이 늘 바쁘다고만 한 것도 손녀 부탁 때문이었죠."
  },
  {
   "spk": "나레이터",
   "text": "그제야 깨달았습니다."
  },
  {
   "spk": "나레이터",
   "text": "손녀는 저를 잊은 게 아니라, 제가 못 지키는 밤을 대신 지키고 있었던 겁니다."
  },
  {
   "spk": "나레이터",
   "text": "그 주 토요일, 처음으로 손녀 퇴근 시간에 맞춰 병원 앞에서 기다렸습니다."
  },
  {
   "spk": "나레이터",
   "text": "따뜻한 국밥 한 그릇 사 먹이고 싶어서요."
  },
  {
   "spk": "나레이터",
   "text": "받은 은혜를 말 대신 시간으로 갚는 아이도 있습니다."
  },
  {
   "spk": "나레이터",
   "text": "여러분에게도 말없이 곁을 지켜 준 가족이 있으신가요?"
  },
  {
   "spk": "나레이터",
   "text": "여러분의 이야기를 댓글로 들려 주세요."
  }
 ],
